<div class="atlas-docs-search-body">
  {{#if available}}
    <div class="form-group">
      <label for="atlas-docs-scope">{{localize "ATLAS.DocsSearch.Scope"}}</label>
      <div class="form-fields">
        <select id="atlas-docs-scope" name="atlas-docs-scope">
          {{#each options as |o|}}
            <option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>
    <div class="form-group">
      <label for="atlas-docs-query">{{localize "ATLAS.DocsSearch.Label"}}</label>
      <div class="form-fields">
        <input type="search" id="atlas-docs-query" name="atlas-docs-query"
          placeholder="{{localize 'ATLAS.DocsSearch.Placeholder'}}" autocomplete="off">
      </div>
    </div>
    <ul class="atlas-docs-results"></ul>
  {{else}}
    <p class="atlas-docs-message">{{localize "ATLAS.DocsSearch.Unavailable"}}</p>
  {{/if}}
</div>
