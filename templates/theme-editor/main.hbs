<div class="atlas-editor-body">
  <div class="atlas-editor-controls">
    <div class="form-group">
      <label for="atlas-custom-name">{{localize "ATLAS.Theme.CustomName"}}</label>
      <div class="form-fields">
        <input type="text" id="atlas-custom-name" name="customName" value="{{name}}">
      </div>
    </div>
    {{#each categories as |cat|}}
      <fieldset class="atlas-color-group">
        <legend>{{localize cat.label}}</legend>
        {{#each cat.fields as |f|}}
          <label class="atlas-color-field">
            <span>{{f.label}}</span>
            <color-picker name="colors.{{f.key}}" value="{{f.value}}" data-key="{{f.key}}"></color-picker>
          </label>
        {{/each}}
      </fieldset>
    {{/each}}
  </div>

  <div class="atlas-editor-side">
    <h4 class="atlas-editor-heading">{{localize "ATLAS.Theme.Preview"}}</h4>
    <div class="atlas-editor-preview">
      <div class="atlas-pv-head">
        <i class="fas fa-palette"></i>
        <span>{{name}}</span>
      </div>
      <div class="atlas-pv-body">
        <div class="atlas-pv-list">
          <div class="atlas-pv-group">{{labels.textHeading}}</div>
          <div class="atlas-pv-row">{{labels.text}}<small>{{labels.textSecondary}}</small></div>
          <div class="atlas-pv-row hover">{{labels.bgHover}}<small>{{labels.textSecondary}}</small></div>
          <div class="atlas-pv-row selected">{{labels.primary}}<small>{{labels.textSecondary}}</small></div>
          <div class="atlas-pv-row">{{labels.text}}<small>{{labels.textSecondary}}</small></div>
        </div>
        <div class="atlas-pv-pane">
          <h4>{{labels.titleText}}</h4>
          <div class="atlas-pv-input"><span>{{localize "ATLAS.Common.SearchPlaceholder"}}</span><i class="fas fa-magnifying-glass"></i></div>
          <p class="atlas-pv-hint">{{labels.textDim}}</p>
          <div class="atlas-pv-callout">{{labels.calloutText}}</div>
          <div class="atlas-pv-chips">
            <span class="ok">{{labels.success}}</span>
            <span class="warn">{{labels.warning}}</span>
            <span class="err">{{labels.error}}</span>
            <span class="acc"><i class="fas fa-star"></i> {{labels.accent}}</span>
          </div>
          <div class="atlas-pv-days">
            <span class="wd">{{labels.weekdayHeader}}</span>
            <span class="rest">{{labels.restDay}}</span>
            <span class="today">{{labels.today}}</span>
          </div>
        </div>
      </div>
      <div class="atlas-pv-foot">
        <span class="atlas-pv-btn">{{labels.buttonText}}</span>
        <span class="atlas-pv-btn primary">{{labels.primary}}</span>
      </div>
    </div>

    <h4 class="atlas-editor-heading">{{localize "ATLAS.Theme.Contrast"}}</h4>
    <ul class="atlas-editor-checks">
      {{#each checks as |label|}}
        <li data-check="{{@index}}">
          <span class="atlas-check-sample">Aa</span>
          <span class="atlas-check-label">{{label}}</span>
          <span class="atlas-check-ratio"></span>
          <i></i>
        </li>
      {{/each}}
    </ul>
  </div>
</div>
